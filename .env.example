# --- LLM provider: local | openai | mistral | huggingface | mock ---
LLM_PROVIDER=local

# Local model (GPU, 4-bit). Fallback is loaded automatically if the main model does not fit.
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_FALLBACK_MODEL=Qwen/Qwen2.5-3B-Instruct
LOCAL_LLM_LOAD_IN_4BIT=true
LOCAL_LLM_MAX_NEW_TOKENS=3600
LOCAL_LLM_TOKENS_PER_QUESTION=420

# Cloud providers (only for the provider you choose)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
HF_API_KEY=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
TOP_K_CHUNKS=6

# --- Open-answer grading ---
OPEN_ANSWER_LOW=0.45
OPEN_ANSWER_HIGH=0.80
OPEN_ANSWER_AGENT=true
OPEN_ANSWER_AGENT_MAX_CALLS=6

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Security: generate a real secret with
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Code required to register as a teacher (empty = disabled, development only)
PROFESSOR_SIGNUP_CODE=

# --- Database (users). SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/quizbot
DATABASE_URL=
